# 複製成 .env 後填值。.env 不可進版控。

# azure | openai
LLM_PROVIDER=azure

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Azure 上的「部署名稱」，不是模型名
AZURE_OPENAI_DEPLOYMENT=

# --- OpenAI（備用，LLM_PROVIDER=openai 時使用）---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# 留空 = 不送 temperature（o 系列 / gpt-5 等推理模型不支援此參數）
LLM_TEMPERATURE=0.3

# --- 資料庫 ---
# 不設 = 本機 SQLite（outputs/coach.db），雙擊 run.bat 即可，不需要 Neon。
# 雲端（Render）：填 Neon 的連線字串（pooled）。postgres:// 開頭會自動轉成 psycopg 3；Neon 一律要 SSL（預設 sslmode=require）
DATABASE_URL=
# 只給 alembic／coach.serve 跑 migration 用（Neon 的 direct 連線字串）；不設就用 DATABASE_URL
DATABASE_URL_DIRECT=

# --- 雲端 ---
# production = 啟動時檢查必要環境變數，缺什麼就報錯；本機不要設
APP_ENV=
# 前面有幾層代理會把來源 IP 附加到 X-Forwarded-For 尾端（限流用）。production 預設 1；本機不要設
TRUSTED_PROXY_HOPS=
# 0 = coach.serve 啟動時不自動套用 migration
RUN_MIGRATIONS=
