# 複製成 .env 後填值。.env 不可進版控。

# azure | openai
LLM_PROVIDER=azure

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Azure 上的「部署名稱」，不是模型名
AZURE_OPENAI_DEPLOYMENT=

# --- OpenAI（備用，LLM_PROVIDER=openai 時使用）---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# 留空 = 不送 temperature（o 系列 / gpt-5 等推理模型不支援此參數）
LLM_TEMPERATURE=0.3
